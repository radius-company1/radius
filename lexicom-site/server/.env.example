# Keep this file on the server, outside the public website. Never use VITE_ for secrets.
HOST=127.0.0.1
PORT=8787
ALLOWED_ORIGINS=https://lexicom.ai,https://radius-company1.github.io
# Enable only behind a local reverse proxy that OVERWRITES X-Real-IP.
TRUST_LOCAL_PROXY=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Bare sender address, permitted by the SMTP account (recipient is fixed in contract.json).
SMTP_FROM=
DATA_DIR=/var/lib/lexicom-contact
# Generate with: openssl rand -hex 32
IDEMPOTENCY_SECRET=
